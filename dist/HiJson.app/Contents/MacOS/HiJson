#!/bin/bash
APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
for jdk in "${JAVA_HOME:-}" "$(/usr/libexec/java_home 2>/dev/null)" /opt/java/jdk8/Contents/Home; do
    if [[ -n "$jdk" && -x "$jdk/bin/java" ]]; then
        exec "$jdk/bin/java" -Xms64m -Xmx512m "-Xdock:icon=$APP_DIR/Resources/HiJson.icns" \
            -Xdock:name=HiJson -jar "$APP_DIR/Resources/Java/HiJson.jar" "$@"
    fi
done
/usr/bin/osascript -e 'display alert "HiJson" message "请先安装 Java 8 或更高版本，再打开 HiJson。"'
exit 1
